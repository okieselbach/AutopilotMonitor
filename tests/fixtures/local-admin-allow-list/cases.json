{
  "description": "Grammar of a Local Admin Analyzer allowed-list entry. C# LocalAdminAllowList and the portal's allowedAccounts.ts must agree on every case. See README.md.",
  "parse": [
    { "entry": "WsiAccount", "pattern": "WsiAccount", "role": "any" },
    { "entry": "WsiAccount|user", "pattern": "WsiAccount", "role": "user" },
    { "entry": "adm-*|USER", "pattern": "adm-*", "role": "user" },
    { "entry": "adm-*", "pattern": "adm-*", "role": "any" },
    { "entry": "user|user", "pattern": "user", "role": "user" },
    { "entry": "Default User", "pattern": "Default User", "role": "any" },
    { "entry": " legacy", "pattern": " legacy", "role": "any", "note": "no qualifier: verbatim, exactly what the entry meant before qualifiers" },
    { "entry": "CONTOSO\\admin", "pattern": "CONTOSO\\admin", "role": "any", "note": "verbatim; never matches a local account, as before" },
    { "entry": "*", "pattern": "*", "role": "any", "note": "a stored legacy entry keeps its meaning" },
    { "entry": "x|admin", "ignored": true },
    { "entry": "|user", "ignored": true },
    { "entry": "a|b|user", "ignored": true },
    { "entry": "x| user", "ignored": true },
    { "entry": "x |user", "ignored": true },
    { "entry": "x|", "ignored": true },
    { "entry": "", "ignored": true },
    { "entry": "   ", "ignored": true }
  ],
  "write": [
    { "entry": "SupportAdmin", "valid": true },
    { "entry": "adm-*", "valid": true },
    { "entry": "ab*", "valid": true },
    { "entry": "lapsAdmin??", "valid": true },
    { "entry": "kiosk|user", "valid": true },
    { "entry": "kiosk|USER", "valid": true },
    { "entry": "user|user", "valid": true },
    { "entry": "Front Desk", "valid": true },
    { "entry": "S-1-team", "valid": true },
    { "entry": "0123456789012345678901234567890123456789012345678901234567890123", "valid": true },
    { "entry": "01234567890123456789012345678901234567890123456789012345678901234", "valid": false, "reason": "65 characters" },
    { "entry": "", "valid": false },
    { "entry": "   ", "valid": false },
    { "entry": " padded", "valid": false },
    { "entry": "padded ", "valid": false },
    { "entry": "ab\u0007", "valid": false },
    { "entry": "*", "valid": false },
    { "entry": "a*", "valid": false },
    { "entry": "?*?", "valid": false },
    { "entry": "*|user", "valid": false },
    { "entry": "x|admin", "valid": false },
    { "entry": "x |user", "valid": false },
    { "entry": "CONTOSO\\admin", "valid": false },
    { "entry": "admin@contoso", "valid": true },
    { "entry": "a:b", "valid": false },
    { "entry": "S-1-12-1-197575099-1178113582", "valid": false },
    { "entry": "s-1-5-21-1-2-3-1001|user", "valid": false }
  ]
}
