<Project>
  <!-- Warning freeze (2026-08-13, backlog cleared to zero): every .NET build in this repo
       must stay warning-free. Compiler, MSBuild and NuGet restore warnings are all fatal.
       Exception: NuGet audit advisories (NU1901-NU1904) stay warnings — a CVE published
       against an already-referenced package must not block an unrelated hotfix deploy;
       advisories are handled by bumping the package, not by failing the build. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
