{
  "$comment": "Parity cases for the session search grammar. Run by the web (app/dashboard/utils/__tests__/sessionSearchQuery.test.ts) and the backend (SessionFreeTextSearchTests) against the SAME sample session: a query that matches on one side must match on the other, or the server sweep returns ghost results the client filters back out. Cases with `extra` are client-only (client-derived tokens the server never sees). All values are synthetic.",
  "session": {
    "deviceName": "DESKTOP-A1B2C3",
    "serialNumber": "5CG1234XYZ",
    "manufacturer": "Contoso",
    "model": "EliteBook 840",
    "status": "Failed",
    "sessionId": "22222222-2222-2222-2222-222222222222",
    "geoCountry": "DE",
    "geoRegion": "Hessen",
    "geoCity": "Frankfurt",
    "agentVersion": "2.0.1400",
    "osName": "Windows 11",
    "osBuild": "26100.1000",
    "osDisplayVersion": "24H2",
    "osEdition": "Enterprise",
    "osLanguage": "de-DE"
  },
  "cases": [
    { "query": "elitebook", "expected": true, "note": "free term, case-insensitive substring" },
    { "query": "5cg1234", "expected": true, "note": "serial" },
    { "query": "2222-2222", "expected": true, "note": "sessionId fragment" },
    { "query": "tailspin", "expected": false, "note": "no field contains it" },
    { "query": "contoso elitebook", "expected": true, "note": "two terms AND-ed, satisfied by different fields" },
    { "query": "Contoso EliteBook 840", "expected": true, "note": "the old Fleet Health link: every word matches on its own" },
    { "query": "\"Contoso EliteBook\"", "expected": false, "note": "a phrase never matches across the manufacturer/model boundary" },
    { "query": "\"EliteBook 840\"", "expected": true, "note": "phrase inside one field" },
    { "query": "model=elitebook", "expected": true, "note": "qualified term" },
    { "query": "model=contoso", "expected": false, "note": "qualifier restricts to the model field only" },
    { "query": "manufacturer=Contoso model=\"EliteBook 840\"", "expected": true, "note": "the new Fleet Health link" },
    { "query": "manufacturer=Contoso model=\"EliteBook 850\"", "expected": false, "note": "second qualifier fails" },
    { "query": "manufacturer:contoso", "expected": true, "note": "colon separator accepted" },
    { "query": "MODEL=ELITEBOOK", "expected": true, "note": "qualifier and value are case-insensitive" },
    { "query": "-model=elitebook", "expected": false, "note": "negated qualifier" },
    { "query": "-model=surface", "expected": true, "note": "negated qualifier that does not hit" },
    { "query": "elitebook -failed", "expected": false, "note": "exclusion wins" },
    { "query": "elitebook -succeeded", "expected": true, "note": "exclusion that does not hit" },
    { "query": "\"a=b\"", "expected": false, "note": "quoted: a literal, not a qualifier" },
    { "query": "foo=bar", "expected": false, "note": "unknown qualifier is a literal term" },
    { "query": "state:failed", "expected": false, "note": "unknown qualifier with colon is a literal term" },
    { "query": "status:failed", "expected": true, "note": "known qualifier with colon" },
    { "query": "\"exit code -1\"", "expected": false, "note": "quoted phrase with a minus is one literal" },
    { "query": "session=2222-2222", "expected": true, "note": "sessionId qualifier" },
    { "query": "device=desktop serial=5cg country=de region=hessen city=frankfurt agent=2.0.1400 os=windows build=26100 osversion=24h2 edition=enterprise language=de-de", "expected": true, "note": "every remaining qualifier" },
    { "query": "model=", "expected": true, "note": "qualifier without a value carries no filter (user still typing)" },
    { "query": "", "expected": true, "note": "empty query matches everything" },
    { "query": "-", "expected": true, "note": "lone minus carries no filter" },
    { "query": "blocked", "expected": true, "extra": "blocked", "note": "client-derived token reachable by a free term" },
    { "query": "model=blocked", "expected": false, "extra": "blocked", "note": "client-derived token is never a field" },
    { "query": "\"1 min\"", "expected": true, "extra": "06/09/2026, 10:00:00\n1 min", "note": "phrase inside one client-derived token" },
    { "query": "\"10:00:00 1\"", "expected": false, "extra": "06/09/2026, 10:00:00\n1 min", "note": "phrase never spans two client-derived tokens" }
  ]
}
