<!--
  Autopilot Monitor Bootstrap MSI - thin MDM LOB delivery vehicle for WDP (Autopilot v2).

  LOB MSIs are installed by the OMA-DM stack (EnterpriseDesktopAppManagement CSP) during
  the first MDM sync, i.e. BEFORE/parallel to the Device Preparation SLDM app batch -
  earlier than any IME-delivered script (Batch 2) or Win32 app can run. The MSI itself
  carries no bootstrap logic and no downloader of its own: it installs the SAME stage-1
  loader that is assigned directly in Intune (scripts/Bootstrap/Start-AutopilotMonitor.ps1)
  and runs it once. The loader downloads the current server-hosted
  Install-AutopilotMonitor.ps1 and verifies its publisher before executing it, so all real
  logic stays updatable without re-shipping the MSI, and both delivery channels share one
  implementation.

  Everything of ours on a device lives under ProgramData. The loader copy goes to the agent
  folder, which the installer owns: it removes the copy in every outcome. Any standard user
  can create that folder first, and Windows Installer keeps a modified unversioned file, so
  the custom action never runs the file at that path as such: it reads the file once, checks
  our Authenticode signature on exactly those bytes (the publisher pin the loader applies to
  the installer) and runs exactly those bytes. PowerShell starts in System32, never in a
  folder users can write to. Windows Installer formats the command: every square bracket and
  every brace of the PowerShell text is written as [\[], [\]], [\{] or [\}], because a brace
  block that holds a bracket is a conditional block to the formatter and loses its braces.

  Build: wix build Package.wxs -arch x64 -o bin\AutopilotMonitor-Bootstrap.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Autopilot Monitor Bootstrap"
           Manufacturer="Autopilot Monitor"
           Version="1.4.0"
           UpgradeCode="1fbe5515-d346-445c-b8b8-14ee79f97522"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Autopilot Monitor Bootstrap is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CompanyFolder" Name="AutopilotMonitor">
        <Directory Id="INSTALLFOLDER" Name="Msi" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="MainComponents" Directory="INSTALLFOLDER">
      <!-- Source is relative to the build working directory (the project dir), not to this
           file. New component GUID because the key path changed (1.4.0: back to ProgramData). -->
      <Component Id="RunnerScript" Guid="5E8D1B6A-2C47-4F93-A1D0-7B9E3C5F8A21">
        <File Id="RunnerPs1"
              Source="..\..\..\scripts\Bootstrap\Start-AutopilotMonitor.ps1"
              Name="Start-AutopilotMonitor.ps1"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Level="1">
      <ComponentGroupRef Id="MainComponents" />
    </Feature>

    <!-- Deferred + no-impersonate: runs as SYSTEM after the file lands. Return=ignore keeps
         the LOB install green whatever happens (the loader is fail-soft itself). Runs on
         every install of the product, upgrades included, so the installer gets to remove the
         copy. -LogFileName keeps this channel distinguishable in a diagnostics package; the
         diag tooling keys on that name. -->
    <CustomAction Id="RunBootstrap"
                  Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$b = [\[]System.IO.File[\]]::ReadAllBytes('[INSTALLFOLDER]Start-AutopilotMonitor.ps1'); $s = Get-AuthenticodeSignature -Content $b -SourcePathOrExtension '.ps1'; if ($s.Status -eq 'Valid' -and $s.SignerCertificate.Subject -like '*O=glueckkanja AG*') [\{] &amp; ([\[]scriptblock[\]]::Create([\[]System.Text.Encoding[\]]::UTF8.GetString($b))) -LogFileName bootstrap-msi.log [\}]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RunBootstrap" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
