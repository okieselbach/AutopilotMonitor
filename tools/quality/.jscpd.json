{
  "format": ["csharp", "typescript", "tsx"],
  "minTokens": 100,
  "ignore": [
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/dist/**",
    "**/out/**",
    "**/.next/**",
    "**/*.Tests/**",
    "**/__tests__/**",
